{
  "key": "gitlab",
  "version": "1.0.0",
  "protocol_version": 1,
  "capability_family": "plugin",
  "display_name": "GitLab",
  "icon": "assets/icon.svg",
  "description": "Connect approved GitLab projects as data sources and read-only assistant tools.",
  "assistant_guidance": {
    "summary": "Use GitLab tools to inspect approved projects and search or read their repository files.",
    "when_to_use": [
      "The user asks for current information from an approved GitLab project.",
      "The user asks to inspect or search code in an approved project."
    ],
    "topics": [
      {
        "key": "project_files",
        "summary": "Read a file or search code inside an approved GitLab project.",
        "details": "Use the namespace/project value selected by the Connection. Do not invent a project outside the Connection allowlist. Use a branch, tag, or commit ref when the user specifies one.",
        "tool_keys": ["gitlab_read_file", "gitlab_search_code"]
      }
    ]
  },
  "datasource_source_type": "git",
  "handlers": {
    "control": "python_v1",
    "runtime": "python_v1"
  },
  "connection_schema": {
    "type": "object",
    "properties": {
      "endpoint": {
        "type": "string",
        "format": "uri",
        "title": "GitLab endpoint",
        "description": "Public or self-managed root HTTPS GitLab endpoint.",
        "default": "https://gitlab.com",
        "write_to": "endpoint"
      },
      "secret_value": {
        "type": "string",
        "format": "password",
        "title": "Personal access token",
        "description": "A write-only token with read access to the approved projects.",
        "write_to": "secret_value"
      },
      "projects": {
        "type": "array",
        "format": "provider-resource",
        "resource": "projects",
        "title": "Allowed projects",
        "description": "Explicit namespace/project values this connection may access.",
        "write_to": "allowed_scope.projects",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["endpoint", "secret_value", "projects"],
    "additionalProperties": false
  },
  "datasource_schema": {
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "format": "provider-resource",
        "resource": "projects",
        "title": "Project"
      },
      "branch": {
        "type": "string",
        "format": "provider-resource-option",
        "resource": "branches",
        "depends_on": "project",
        "title": "Branch"
      },
      "directory": {
        "type": "string",
        "format": "repository-path",
        "title": "Directory",
        "description": "Optional project-relative directory to sync."
      }
    },
    "required": ["project"],
    "additionalProperties": false
  },
  "tools": [
    {
      "key": "gitlab_read_file",
      "description": "Read a UTF-8 text file from an approved GitLab project.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {"type": "string"},
          "path": {"type": "string"},
          "ref": {"type": "string"}
        },
        "required": ["project", "path"],
        "additionalProperties": false
      }
    },
    {
      "key": "gitlab_search_code",
      "description": "Search code within an approved GitLab project and return bounded file metadata.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {"type": "string"},
          "query": {"type": "string"},
          "path": {"type": "string"},
          "ref": {"type": "string"},
          "max_results": {"type": "integer"}
        },
        "required": ["project", "query"],
        "additionalProperties": false
      }
    }
  ]
}
