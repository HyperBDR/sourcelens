#: accounts/services/email.py
msgid "Complete Your Registration"
msgstr "Completa tu registro"

#: accounts/services/email.py
#, python-format
msgid "Please complete your registration by visiting: %(url)s"
msgstr "Completa tu registro visitando: %(url)s"

#: accounts/services/email.py
msgid "Your login verification code"
msgstr "Tu código de verificación de inicio de sesión"

#: accounts/services/email.py
#, python-format
msgid "Your verification code is %(code)s. It expires in %(minutes)s minutes. If you did not request it, ignore this email."
msgstr "Tu código de verificación es %(code)s. Caduca en %(minutes)s minutos. Si no lo solicitaste, ignora este correo."

#: accounts/services/email.py
msgid "Set or Reset Your Password"
msgstr "Configura o restablece tu contraseña"

#: accounts/services/email.py
#, python-format
msgid "Please set or reset your password by visiting: %(url)s"
msgstr "Configura o restablece tu contraseña visitando: %(url)s"

#: accounts/urls.py accounts/views/login_otp.py
msgid "Human verification failed."
msgstr "La verificación humana ha fallado."

#: accounts/views/login_otp.py
msgid "The verification code has expired."
msgstr "El código de verificación ha caducado."

#: accounts/views/login_otp.py
msgid "The verification code is incorrect."
msgstr "El código de verificación es incorrecto."
